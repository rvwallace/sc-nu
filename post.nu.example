# Local Post Interactive Configuration Example (sc-nu)
# Copy this file to the XDG Nushell directory (which is gitignored):
#   cp post.nu.example "${XDG_CONFIG_HOME:-$HOME/.config}/nushell/local/post.nu"
#
# Loaded as a module late in config.nu for interactive shells only.
# Use it for personal aliases, machine-specific commands, or experimental tools.

# Toolbox companion modules:
# https://github.com/rvwallace/toolbox
# Change this path to your toolbox checkout.
export use /path/to/toolbox/shell/init.nu *

# alias my-custom-tool = ...
